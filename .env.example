# Copy this file to .env and fill in values as needed.
# Every setting has a working default — a .env file is optional.
# Do not commit real credentials or tokens to this repository.

# ---- Identification (recommended, not required) ----
# OpenAlex grants higher rate limits to requests with a contact email.
CONTACT_EMAIL=harivasank@gamil.com

# ---- Optional API keys ----
# Semantic Scholar works without a key; a key just raises rate limits.
# Request one at: https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=s2k-egSj06AV31hblASP0vESoffjkr6YJFX6OVroq0kZ

# ---- CORS (for API access) ----
# Comma-separated list of allowed origins for HTTP requests to the FastAPI backend.
# Default: http://localhost:* and http://127.0.0.1:* (local development)
# Production example: CORS_ALLOWED_ORIGINS=https://api.example.com
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ---- Networking ----
REQUEST_TIMEOUT=15
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=0.5
MIN_REQUEST_INTERVAL=0.15

# ---- Local caching ----
CACHE_ENABLED=true
# Runtime default uses a dedicated writable data directory inside the container
# which avoids permission issues when the project is bind-mounted into /app.
CACHE_DB_PATH=/data/cache.sqlite3
CACHE_TTL_SECONDS=3600

# ---- Pagination ----
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=50

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FILE=journal_search_mcp.log
